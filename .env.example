AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# Only needed for Step 3 (main_agent_service.py / probe_foundry_agent_service.py).
# The Agent Service authenticates via Entra ID service principal, not an API key.
AZURE_TENANT_ID=<your-azure-ad-tenant-id>
AZURE_CLIENT_ID=<your-service-principal-app-id>
AZURE_CLIENT_SECRET=<your-service-principal-secret>
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/api/projects/<your-project-name>
